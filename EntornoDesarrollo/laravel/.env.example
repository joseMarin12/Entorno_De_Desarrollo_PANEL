# ==============================================================================
# ⚠  THIS FILE BECOMES THE PRODUCTION .env
#
# The Dockerfile runs `cp .env.example .env` during the image build, so every
# UNCOMMENTED line here ships as a real production value. Cloud Run environment
# variables override it at runtime (phpdotenv never overwrites an existing env
# var), so anything injected by GCP wins.
#
# Rule: keep environment-specific values (local URLs, secrets) COMMENTED OUT.
# Put the real local values in your own .env, which is gitignored.
# ==============================================================================

# ==============================================================================
# Application
# ==============================================================================
APP_NAME=Panel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ==============================================================================
# Database (PostgreSQL)
# Overridden by the Cloud Run environment in production.
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=panel
DB_USERNAME=admin
DB_PASSWORD=SGPasswordPostgres

# ==============================================================================
# Stateless drivers
# This app is a stateless JSON API: no sessions/cache/jobs tables exist in the
# schema, so the framework defaults ("database") must be overridden.
# ==============================================================================
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ==============================================================================
# n8n — commented on purpose
#
# Leaving these unset makes the application fall back to the production
# endpoints defined in the controllers, which is the correct behaviour for a
# deployed image. Uncomment them in your local .env with the Docker hostnames.
# ==============================================================================

# Shared HS256 key. Laravel signs the JWT on login and verifies it on every
# request; n8n validates it with the same value (JWT_HASH in the workflows).
# Rotating it requires changing it in n8n at the same time.
# JWT_SECRET=

# Webhook endpoints. Laravel proxies each resource to its n8n workflow.
# Local values use the Docker service hostname:
# N8N_WEBHOOK_LOGIN_URL=http://n8n:5678/webhook/login
# N8N_WEBHOOK_ASIGNACIONES=http://n8n:5678/webhook/asignaciones
# N8N_WEBHOOK_COMERCIALES=http://n8n:5678/webhook/gestion-comerciales
# N8N_WEBHOOK_CONTACTOS_EMPRESA=http://n8n:5678/webhook/gestion-contactos
# N8N_WEBHOOK_DIRECCIONES_EMPRESA=http://n8n:5678/webhook/gestion-direcciones
# N8N_WEBHOOK_EMPRESAS_URL=http://n8n:5678/webhook/gestion-empresas
# N8N_WEBHOOK_FORMACIONES_URL=http://n8n:5678/webhook/gestion-formaciones
# N8N_WEBHOOK_SELECCIONADORES=http://n8n:5678/webhook/gestion-seleccionadores
# N8N_WEBHOOK_TRABAJADORES=http://n8n:5678/webhook/gestion-trabajadores
# N8N_WEBHOOK_USUARIOS_URL=http://n8n:5678/webhook/usuarios
